generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// USUÁRIOS E AUTENTICAÇÃO
// -------------------------------------------------------------
model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  password      String?
  role          Role           @default(GESTOR)
  organizations Organization[]
  assignedMatches Match[]      @relation("RefereeMatches")
  teamRegistrations Team[]     @relation("TeamManager")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum Role {
  SUPER_ADMIN
  GESTOR
  ARBITRO
  EQUIPE
}

// -------------------------------------------------------------
// GESTÃO / ORGANIZAÇÃO (/nomedagestao)
// -------------------------------------------------------------
model Organization {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique // ex: liga-carioca
  logoUrl         String?
  planStatus      PlanStatus     @default(TRIAL)
  subscriptionId  String?        // ID da assinatura no Mercado Pago
  ownerId         String
  owner           User           @relation(fields: [ownerId], references: [id])
  competitions    Competition[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

enum PlanStatus {
  TRIAL
  ACTIVE
  INACTIVE
  CORTESIA
}

// -------------------------------------------------------------
// COMPETIÇÕES E CATEGORIAS
// -------------------------------------------------------------
model Competition {
  id             String        @id @default(cuid())
  name           String
  logoUrl        String?
  status         CompStatus    @default(DRAFT)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories     Category[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum CompStatus {
  DRAFT
  REGISTRATION
  ACTIVE
  FINISHED
}

model Category {
  id             String         @id @default(cuid())
  name           String         // ex: Sub-9, Sub-11, Adulto
  format         CategoryFormat @default(PONTOS_CORRIDOS)
  competitionId  String
  competition    Competition    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  teams          Team[]
  matches        Match[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

enum CategoryFormat {
  PONTOS_CORRIDOS
  MATA_MATA
  GRUPOS_E_MATA_MATA
}

// -------------------------------------------------------------
// EQUIPES E ATLETAS
// -------------------------------------------------------------
model Team {
  id           String        @id @default(cuid())
  name         String
  logoUrl      String?
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  managerId    String?
  manager      User?         @relation("TeamManager", fields: [managerId], references: [id])
  players      Player[]
  homeMatches  Match[]       @relation("HomeTeam")
  awayMatches  Match[]       @relation("AwayTeam")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Player {
  id          String        @id @default(cuid())
  name        String
  number      Int?
  photoUrl    String?
  document    String?       // RG/CPF para controle da gestão
  teamId      String
  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  events      MatchEvent[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// -------------------------------------------------------------
// PARTIDAS, ARBITRAGEM E EVENTOS AO VIVO
// -------------------------------------------------------------
model Match {
  id           String        @id @default(cuid())
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  homeTeamId   String
  homeTeam     Team          @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId   String
  awayTeam     Team          @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore    Int           @default(0)
  awayScore    Int           @default(0)
  matchDate    DateTime?
  location     String?       // Quadra / Campo / Ginásio
  status       MatchStatus   @default(AGENDADO)
  refereeId    String?
  referee      User?         @relation("RefereeMatches", fields: [refereeId], references: [id])
  events       MatchEvent[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum MatchStatus {
  AGENDADO
  EM_ANDAMENTO
  INTERVALO
  ENCERRADO
  CANCELADO
}

model MatchEvent {
  id         String     @id @default(cuid())
  matchId    String
  match      Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId   String?
  player     Player?    @relation(fields: [playerId], references: [id])
  eventType  EventType
  minute     Int        // Minuto do acontecimento (ex: 12')
  period     String?    // 1T, 2T, Prorrogação
  notes      String?
  createdAt  DateTime   @default(now())
}

enum EventType {
  GOL
  GOL_CONTRA
  CARTAO_AMARELO
  CARTAO_VERMELHO
  FALTA
}